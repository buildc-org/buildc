schema-version 1
name "Broken Sources"

libraries default="absent" {
    local {
        broken-sources-library { source "." }
        buildc-org { source "../components" }
        Scratch { source "../components" }
        pinned {
            source "../components"
            version "v1.0.0"
        }
        hosted { source "https://github.com/buildc-org/modules" }
    }
    remote {
        buildc-org {
            source "https://github.com/buildc-org/modules"
            version "v1.0.0"
        }
        insecure { source "http://github.com/buildc-org/modules" }
        unfetched { source "../components" }
        nowhere
    }
    stray { source "../components" }
}

library { components "../outside" }

builds {
    broken-sources
}
