---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- one/contradicts ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/refused/components/one/contradicts.sh,target=/generated/refused/components/one/contradicts.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/refused/components/one/contradicts.sh

# ---- one/typo ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/refused/components/one/typo.sh,target=/generated/refused/components/one/typo.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/refused/components/one/typo.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- declared conformance ----
ARG CONFORMS=

# ---- measured content ----
ARG SCAP_CONTENT=

# ---- claimed and refused rules ----
ARG SCAP_CLAIMED=
ARG SCAP_REFUSED=

# ---- image identity ----
ARG IMAGE_ID="refused"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --mount=type=bind,from=ctx,source=/generated/refused/finalize.sh,target=/generated/refused/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/refused/scap,target=/ctx/scap \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" CONFORMS="${CONFORMS}" SCAP_CONTENT="${SCAP_CONTENT}" FAMILY="${FAMILY}" SCAP_CLAIMED="${SCAP_CLAIMED}" SCAP_REFUSED="${SCAP_REFUSED}" IMAGE_ID="${IMAGE_ID}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /generated/refused/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/buildc/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
ARG BUILDC_VERSION=""
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" BUILDC_VERSION="${BUILDC_VERSION}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" bash /ctx/lib/build-record.sh

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
