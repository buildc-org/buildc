   `----
    ,-[tests/repos/broken-sources/repo.kdl:16:9]
 15 |     remote {
 16 |         buildc-org {
    :         ^^^^^|^^^^
    :              `-- and again here
 17 |             source "https://github.com/buildc-org/modules"
