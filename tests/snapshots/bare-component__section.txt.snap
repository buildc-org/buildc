---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- hello ----
RUN --mount=type=bind,from=ctx,source=/generated/bare-component/components/hello,target=/ctx/components/hello \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/bare-component/components/hello.sh,target=/generated/bare-component/components/hello.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/bare-component/components/hello.sh

# ---- hello overlays ----
COPY --from=ctx /generated/bare-component/components/hello/files/ /

# ---- menu ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/bare-component/components/menu.sh,target=/generated/bare-component/components/menu.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/bare-component/components/menu.sh

# ---- apps ----
RUN --mount=type=bind,from=ctx,source=/generated/bare-component/components/apps,target=/ctx/components/apps \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/bare-component/components/apps.sh,target=/generated/bare-component/components/apps.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/bare-component/components/apps.sh

# ---- apps/editor ----
RUN --mount=type=bind,from=ctx,source=/generated/bare-component/components/apps/editor,target=/ctx/components/apps/editor \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/bare-component/components/apps/editor.sh,target=/generated/bare-component/components/apps/editor.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/bare-component/components/apps/editor.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- image identity ----
ARG IMAGE_ID="bare-component"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --mount=type=bind,from=ctx,source=/generated/bare-component/finalize.sh,target=/generated/bare-component/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" FAMILY="${FAMILY}" IMAGE_ID="${IMAGE_ID}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /generated/bare-component/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/buildc/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
ARG BUILDC_VERSION=""
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" BUILDC_VERSION="${BUILDC_VERSION}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" bash /ctx/lib/build-record.sh

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
