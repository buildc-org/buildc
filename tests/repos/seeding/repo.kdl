schema-version 1
name "Seeding"

builds default="example" {
    example
}

seed "example" collection="buildc-org"

libraries default="seeding-library" {
    local {
        seeding-library { source "." }
        scratch { source "scratch" }
    }
    remote {
        buildc-org {
            source "https://github.com/buildc-org/modules"
            version "v1.0.0"
        }
    }
}

manifest {
    label #true
}
