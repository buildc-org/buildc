---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

# ---- capability versions ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    FAMILY=fedora FLAVOUR="${FLAVOUR:-}" PROVIDES="libostree|libostree-1-1" FLOORS="libostree|2025.3||core/needs" \
    bash /ctx/lib/measure-base.sh

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- core/needs ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/versioned/components/core/needs.sh,target=/generated/versioned/components/core/needs.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/versioned/components/core/needs.sh

# ---- core/tools ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/versioned/components/core/tools.sh,target=/generated/versioned/components/core/tools.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/versioned/components/core/tools.sh

# ---- core/needs-build-tool ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/versioned/components/core/needs-build-tool.sh,target=/generated/versioned/components/core/needs-build-tool.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/versioned/components/core/needs-build-tool.sh

# ---- core/needs-dnf5 ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/versioned/components/core/needs-dnf5.sh,target=/generated/versioned/components/core/needs-dnf5.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/versioned/components/core/needs-dnf5.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- image identity ----
ARG IMAGE_ID="versioned"
ARG IMAGE_NAME="Versioned"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --mount=type=bind,from=ctx,source=/generated/versioned/finalize.sh,target=/generated/versioned/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" FAMILY="${FAMILY}" IMAGE_ID="${IMAGE_ID}" IMAGE_NAME="${IMAGE_NAME}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /generated/versioned/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/buildc/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
ARG BUILDC_VERSION=""

# ---- capability versions ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    FAMILY=fedora FLAVOUR="${FLAVOUR:-}" MEASURED="core/tools|package-manager/dnf5|dnf5|" \
    bash /ctx/lib/measure-image.sh

RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" BUILDC_VERSION="${BUILDC_VERSION}" VERSIONS_FILE=/usr/share/buildc/versions \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" bash /ctx/lib/build-record.sh

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
