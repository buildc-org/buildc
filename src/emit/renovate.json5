// `buildc generate` writes this file from the `renovate` block in repo.kdl.
// `buildc verify` byte-compares it, so the policy is changed in repo.kdl.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // `buildc generate` writes the workflows and `buildc verify` byte-compares
  // them, so a bump inside one is reverted by the next regeneration.
  "ignorePaths": [".github/workflows/**"],

  // A generated Containerfile sits under its image's own directory, which the
  // dockerfile manager does not recognise, and its FROM has to bump with the
  // declaration below.
  "dockerfile": {
    "managerFilePatterns": ["/^generated/[^/]+/Containerfile$/"],
  },

  "customManagers": [
    {
      "customType": "regex",
      // The tag carries the version, so the leading v comes back off.
      "description": "The pinned build tool release",
      "managerFilePatterns": ["/^repo\\.kdl$/"],
      "extractVersionTemplate": "^v(?<version>.+)$",
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\nbuildc-version \"(?<currentValue>[^\"]+)\"",
    // buildc:managers
      ],
    },
    {
      "customType": "regex",
      "description": "Base image reference in an image file",
      "managerFilePatterns": ["/^[^/]+\\.kdl$/"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "base \"(?<depName>[^\":]+):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?\"",
      ],
    },
    {
      "customType": "regex",
      // Every asset pin spells its tracker the same way, so one manager covers
      // them all. RE2 has no negative lookahead. The leading-lowercase rule
      // excludes an underscore-prefixed component directory.
      "description": "Version-tagged pins",
      "managerFilePatterns": [
        "/^modules/([a-z][^/]*/)?[a-z][^/]*/module\\.kdl$/",
      ],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>github-releases|github-tags)\" depName=\"(?<depName>[^\"]+)\"(?: extractVersion=\"(?<extractVersion>[^\"]+)\")?\\s*\\n\\s*version \"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      "customType": "regex",
      "description": "Commit-pinned asset pins in module.kdl",
      "managerFilePatterns": ["/^modules/([a-z][^/]*/)?[a-z][^/]*/module\\.kdl$/"],
      "matchStrings": [
        "renovate datasource=\"(?<datasource>git-refs)\" depName=\"(?<depName>[^\"]+)\"\\s*\\n\\s*version \"(?<currentDigest>[^\"]+)\"",
      ],
      // The regex manager requires a currentValue even for a digest-only pin.
      "currentValueTemplate": "master",
    },
  ],
}
