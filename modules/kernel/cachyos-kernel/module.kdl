description "CachyOS kernel and companions, with Secure Boot module signing"

supports "fedora"

provides "kernel-devel"
provides-file "/usr/share/buildc/sb_cert.der"
provides-file "/usr/lib/buildc/kernel-package"

provides-file "/usr/libexec/kernel-devel-helpers.sh"

collects "dracut.modules" into="/usr/lib/buildc/dracut.modules"

arg "KERNEL"
secret "mok_privkey"
