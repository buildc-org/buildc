schema-version 1

image {
    name "Sealed"

    base-image {
        debian-forky
    }

    layout {
        filesystem "xfs" subvolumes=#true pool="rpool"
        var-disk "sdb"
    }

}

image {
    name "Halfway"

    base-image {
        arch-bootc-latest
    }

    layout {
        filesystem "zfs"
        composefs #true
    }

}
