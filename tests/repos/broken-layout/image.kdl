schema-version 1

image "sealed" {
    base-image {
        debian-forky
    }

    layout {
        filesystem "xfs" subvolumes=#true pool="rpool"
        var-disk "sdb"
    }

}

image "halfway" {
    base-image {
        arch-bootc-latest
    }

    layout {
        filesystem "zfs"
        composefs #true
    }

}
