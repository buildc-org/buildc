---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- fedora-family ----
RUN --network=none --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family.sh,target=/generated/network/components/fedora-family.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/network/components/fedora-family.sh

# ---- core/tools ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/packages/core/tools.sh,target=/generated/network/packages/core/tools.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/network/packages/core/tools.sh

RUN --network=none --mount=type=bind,from=ctx,source=/generated/network/components/core/tools,target=/ctx/components/core/tools \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/tools.sh,target=/generated/network/components/core/tools.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/network/components/core/tools.sh

# ---- core/fetcher ----
RUN --mount=type=bind,from=ctx,source=/generated/network/components/core/fetcher,target=/ctx/components/core/fetcher \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/fetcher.sh,target=/generated/network/components/core/fetcher.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/network/components/core/fetcher.sh

# ---- core/quiet ----
RUN --network=none --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/quiet.sh,target=/generated/network/components/core/quiet.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/network/components/core/quiet.sh

# ---- core/quiet overlays ----
COPY --from=ctx /generated/network/components/core/quiet/files/ /

# ---- core/spliced ----
# verbatim from components/core/spliced/Containerfile.inc:
RUN true

RUN --network=none --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib,rw \
    --mount=type=bind,from=ctx,source=/generated/network/components/fedora-family/lib/family.sh,target=/ctx/lib/family.sh \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/spliced.sh,target=/generated/network/components/core/spliced.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/network/components/core/spliced.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- image identity ----
ARG IMAGE_ID="network"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --network=none --mount=type=bind,from=ctx,source=/generated/network/finalize.sh,target=/generated/network/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/network/components/core/tools,target=/ctx/components/core/tools \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" FAMILY="${FAMILY}" IMAGE_ID="${IMAGE_ID}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /generated/network/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/buildc/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
ARG BUILDC_VERSION=""
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" BUILDC_VERSION="${BUILDC_VERSION}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" bash /ctx/lib/build-record.sh

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
