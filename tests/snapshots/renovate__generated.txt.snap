#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f repo.kdl ] || cd ..

roots=(generated/lib components)
for dir in generated/scripts scripts; do
    [ ! -d "$dir" ] || roots+=("$dir")
done
mapfile -t scripts < <(find "${roots[@]}" \
    -name '*.sh' ! -name repo.sh -type f ! \( -path '*/files/*' \
    \( -path '*/libexec/*' -o -path '*/system-generators/*' \) \) -print)
mapfile -t repos < <(find components -name repo.sh -type f -print)
mapfile -t helpers < <(find components -path '*/files/*' -type f \
    \( -path '*/libexec/*' -o -path '*/system-generators/*' \) -print)
shfmt=(shfmt -i 4 -ci -bn -sr)
counted="${#scripts[@]} scripts, ${#repos[@]} repo files and ${#helpers[@]} helpers"

if [ "${1:-}" = "--fix" ]; then
    "${shfmt[@]}" -w "${scripts[@]}" "${repos[@]}" "${helpers[@]}"
    echo "lint: formatted ${counted}"
    exit
fi

for tool in shellcheck shfmt; do
    command -v "$tool" > /dev/null 2>&1 || {
        echo "lint: $tool not found, install it first" >&2
        exit 1
    }
done

shellcheck -s bash "${scripts[@]}"
# A repo.sh sets REPO_ID for the generated script.
# Shellcheck cannot see that reader, so SC2034 is off for these files.
[ "${#repos[@]}" -eq 0 ] || shellcheck -s bash -e SC2034 "${repos[@]}"
[ "${#helpers[@]}" -eq 0 ] || shellcheck "${helpers[@]}"
"${shfmt[@]}" -d "${scripts[@]}" "${repos[@]}" "${helpers[@]}" || {
    echo "lint: unformatted, run ./generated/scripts/lint.sh --fix" >&2
    exit 1
}
echo "lint: ${counted} pass shellcheck and shfmt"

./generated/scripts/buildc.sh check

./generated/scripts/buildc.sh verify
==== generated/scripts/buildc.sh
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f repo.kdl ] || cd ..

die() {
    echo "buildc: $*" >&2
    exit 1
}

REPO="buildc-org/buildc"

line="$(sed -n '/^[[:space:]]*buildc-version[[:space:]]/p' repo.kdl)"
if [[ "$line" =~ ^[[:space:]]*buildc-version[[:space:]]+\"([^\"]+)\"(.*)$ ]]; then
    version="${BASH_REMATCH[1]}"
    rest="${BASH_REMATCH[2]%%//*}"
elif [ -n "$line" ]; then
    die "repo.kdl declares no readable buildc-version"
else
    latest="$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
        "https://github.com/${REPO}/releases/latest")" \
        || die "cannot resolve the latest release of ${REPO}"
    [[ "$latest" =~ /tag/v([^/]+)$ ]] \
        || die "cannot read a release out of ${latest}"
    version="${BASH_REMATCH[1]}"
    rest=""
    echo "buildc: repo.kdl pins no release, using the latest, ${version}" >&2
fi

sha256=""
if [[ "$rest" =~ (^|[[:space:]])sha256[[:space:]]*= ]]; then
    if [[ "$rest" =~ (^|[[:space:]])sha256[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
        sha256="${BASH_REMATCH[2]}"
    else
        die "repo.kdl declares no readable sha256 for buildc-version"
    fi
    [[ "$sha256" =~ ^[0-9a-f]{64}$ ]] \
        || die "repo.kdl declares a malformed sha256 for buildc-version"
fi

case "$(uname -m)" in
    x86_64 | aarch64) arch="$(uname -m)" ;;
    *) die "Linux is published for x86_64 and aarch64, and this is $(uname -m)" ;;
esac

if [ -n "$sha256" ] && [ "$arch" != "x86_64" ]; then
    die "repo.kdl pins the sha256 of the x86_64 release, and this is ${arch}"
fi

# The hash joins the cache name so a same-version repin cannot reuse the old binary.
bin="${BUILDC_BIN:-out/buildc-${version}${sha256:+-${sha256}}}"

if [ ! -x "$bin" ]; then
    asset="buildc-v${version}-${arch}-linux-musl.tar.gz"
    url="https://github.com/${REPO}/releases/download/v${version}/${asset}"

    mkdir -p out
    tmp="$(mktemp -d -p out download.XXXXXXXX)"
    trap 'rm -rf "$tmp"' EXIT

    curl -fsSL --retry 3 --retry-all-errors -o "${tmp}/${asset}" "$url" \
        || die "cannot fetch ${url}"
    # A declared hash verifies the download on its own, so the published .sha256 file is fetched only when the declaration carries none.
    if [ -n "$sha256" ]; then
        (cd "$tmp" && printf '%s  %s\n' "$sha256" "$asset" \
            | sha256sum --check --status) \
            || die "${asset} does not match the sha256 repo.kdl declares"
    else
        curl -fsSL --retry 3 --retry-all-errors -o "${tmp}/sha256" "${url}.sha256" \
            || die "cannot fetch ${url}.sha256"
        (cd "$tmp" && printf '%s  %s\n' "$(cat sha256)" "$asset" \
            | sha256sum --check --status) \
            || die "${asset} does not match its published checksum"
    fi

    tar -xzf "${tmp}/${asset}" -C "$tmp" buildc
    mv "${tmp}/buildc" "$bin"
    rm -rf "$tmp"
    trap - EXIT
fi

if [ "${1:-}" = "--path" ]; then
    echo "$bin"
    exit 0
fi

exec "$bin" "$@"
==== generated/scripts/smoke.sh
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
[ -f repo.kdl ] || cd ..

RENDERER=/usr/libexec/grub-menu-from-bls
PORT=2222

die() {
    echo "smoke: $*" >&2
    exit 1
}

[ "$#" -eq 2 ] || [ "$#" -eq 3 ] \
    || die "usage: generated/scripts/smoke.sh <image-ref in root's store> <work dir> [target]"
ref="$1"
dir="$(realpath -m "$2")"
mkdir -p "$dir"
for tool in jq qemu-system-x86_64 ssh ssh-keygen; do
    command -v "$tool" > /dev/null 2>&1 || die "$tool is not installed"
done

recipe="$(./generated/scripts/buildc.sh recipe ${3:+--target "$3"})"
filesystem="$(jq -r .filesystem <<< "$recipe")"
composefs="$(jq -r .composeFsBackend <<< "$recipe")"
bootloader="$(jq -r .bootloader <<< "$recipe")"

rm -f "${dir}/key" "${dir}/key.pub" "${dir}/disk.raw"
ssh-keygen -q -t ed25519 -f "${dir}/key" -N '' -C smoke
truncate -s "${DISK_SIZE:-20G}" "${dir}/disk.raw"

# The kernel sends unit status to the last console=, so ttyS0 comes last.
args=(
    --via-loopback --generic-image --filesystem "$filesystem"
    --karg console=tty0 --karg 'console=ttyS0,115200n8'
    --karg systemd.wants=sshd.service
)
case "$bootloader" in
    "" | grub2) ;;
    *) args+=(--bootloader "$bootloader") ;;
esac
mounts=()
# A composefs install reads an OCI layout, so the image is pushed there before bootc runs.
if [ "$composefs" = true ]; then
    sudo rm -rf "${dir}/oci"
    sudo podman push -q "$ref" "oci:${dir}/oci"
    mounts=(-v "${dir}/oci:/oci:ro")
    args+=(--composefs-backend --source-imgref oci:/oci)
fi
sudo podman run --rm --privileged --pull=never --pid=host --net=host \
    --security-opt label=type:unconfined_t \
    -v /dev:/dev \
    -v /var/lib/containers/storage:/var/lib/containers/storage \
    -v "${dir}:/output" \
    "${mounts[@]}" \
    "$ref" bootc install to-disk "${args[@]}" /output/disk.raw

render_menu() {
    local lo target device root="" status=0
    target="$(mktemp -d)"
    mkdir "${target}/boot"
    lo="$(sudo losetup --show -fP "${dir}/disk.raw")"
    for device in "${lo}"p*; do
        [ -b "$device" ] || continue
        sudo mount "$device" "${target}/boot" 2> /dev/null || continue
        if [ -d "${target}/boot/loader/entries" ]; then
            root=/target
            break
        fi
        if [ -d "${target}/boot/boot/loader/entries" ]; then
            root=/target/boot
            break
        fi
        sudo umount "${target}/boot"
    done
    if [ -z "$root" ]; then
        sudo losetup -d "$lo"
        die "no partition of the disk carries \`loader/entries\`"
    fi
    sudo podman run --rm --net=none --security-opt label=disable \
        -v "${target}:/target" --entrypoint "" "$ref" \
        /bin/sh -c "test -x ${RENDERER} || exit 3; exec ${RENDERER} ${root}" || status=$?
    sudo umount "${target}/boot"
    sudo losetup -d "$lo"
    rmdir "${target}/boot" "$target"
    case "$status" in
        0) echo "smoke: rendered the boot menu" ;;
        3) ;;
        *) die "${RENDERER} failed: exit ${status}" ;;
    esac
}
render_menu
sudo chown "$(id -u):$(id -g)" "${dir}/disk.raw"

secure_boot="${SECURE_BOOT:-1}"
if [ "$secure_boot" = 1 ]; then
    firmware=(/usr/share/OVMF/OVMF_CODE_4M.secboot.fd:/usr/share/OVMF/OVMF_VARS_4M.ms.fd
        /usr/share/edk2/ovmf/OVMF_CODE.secboot.fd:/usr/share/edk2/ovmf/OVMF_VARS.secboot.fd)
    machine=(-machine 'q35,smm=on' -global 'driver=cfi.pflash01,property=secure,value=on')
else
    firmware=(/usr/share/OVMF/OVMF_CODE_4M.fd:/usr/share/OVMF/OVMF_VARS_4M.fd
        /usr/share/edk2/ovmf/OVMF_CODE.fd:/usr/share/edk2/ovmf/OVMF_VARS.fd)
    machine=(-machine q35)
fi
code=""
for pair in "${firmware[@]}"; do
    if [ -f "${pair%%:*}" ] && [ -f "${pair#*:}" ]; then
        code="${pair%%:*}"
        cp "${pair#*:}" "${dir}/vars.fd"
        break
    fi
done
[ -n "$code" ] || die "no OVMF firmware for SECURE_BOOT=${secure_boot} is installed"
# shellcheck disable=SC2016 # expanded by systemd, from each family's EnvironmentFile
dropin="$(printf '%s\n' '[Service]' 'ExecStart=' \
    'ExecStart=/usr/sbin/sshd -D -oPermitRootLogin=prohibit-password $OPTIONS $SSHD_OPTS' \
    | base64 -w0)"
qemu-system-x86_64 \
    -smbios "type=11,value=io.systemd.credential.binary:ssh.authorized_keys.root=$(base64 -w0 "${dir}/key.pub")" \
    -smbios "type=11,value=io.systemd.credential.binary:systemd.unit-dropin.sshd.service=${dropin}" \
    -smbios "type=11,value=io.systemd.credential.binary:systemd.unit-dropin.ssh.service=${dropin}" \
    "${machine[@]}" -m "${RAM:-4096}" -smp 2 -cpu host -enable-kvm -display none \
    -drive "if=pflash,unit=0,format=raw,readonly=on,file=${code}" \
    -drive "if=pflash,unit=1,format=raw,file=${dir}/vars.fd" \
    -serial "file:${dir}/console.log" \
    -drive "file=${dir}/disk.raw,if=virtio,format=raw" \
    -nic "user,hostfwd=tcp:127.0.0.1:${PORT}-:22" \
    -daemonize -pidfile "${dir}/qemu.pid" \
    > "${dir}/qemu.log" 2>&1

on_machine() {
    ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=5 -o LogLevel=ERROR -i "${dir}/key" -p "$PORT" root@localhost "$@"
}
for i in $(seq 60); do
    if on_machine true 2> /dev/null; then
        echo "smoke: ssh answered after ${i} attempts"
        # The SecureBoot efivar holds four attribute bytes before its one-byte value.
        sb=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
        state=0
        if on_machine test -e "$sb"; then
            state="$(on_machine od -An -tu1 -j4 -N1 "$sb" | tr -d ' ')"
        fi
        [ "$state" = "$secure_boot" ] \
            || die "the machine reads Secure Boot as '${state}' where SECURE_BOOT is ${secure_boot}"
        exit 0
    fi
    sleep 10
done
die "ssh did not answer in ten minutes; the serial console is ${dir}/console.log"
==== generated/scripts/vm.sh
#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2154
set -euo pipefail

RENDERER=/usr/libexec/grub-menu-from-bls
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.."
[ -f repo.kdl ] || cd ..
source ./generated/lib/vm-helpers.sh

die() {
    echo "vm: $*" >&2
    exit 1
}

usage() {
    cat >&2 << 'EOF'
usage: generated/scripts/vm.sh <command> <qcow2|raw> [options]

  build     convert the container image into a disk image under out/
  run       boot that disk image under qemu, building it if it is missing
  spawn     boot it with systemd-vmspawn instead

  An installer ISO is not a VM disk. Use `buildc media`.

  --image <ref>       container image to convert (default: localhost/ and
                      the plan's ungated published name)
  --tag <tag>         its tag (default: $DEFAULT_TAG, else latest)
  --target <image/flavour>
                      what a rebuild builds (default: the plan's ungated target)
  --rebuild           generate, then build the container image
                      first. The one form of this that changes the repository.
  --ram <size>        memory for the virtual machine (default: 8G)
  --installer <which> what converts the image into a disk: `bib` for
                      bootc-image-builder, `bootc` for `bootc install to-disk`.
                      `buildc vm` passes this off the target's base family; the
                      default here is bib, which is fedora-only.

Environment:
  BIB_IMAGE           bootc-image-builder image
  DISK_SIZE           size of the disk `--installer bootc` writes (default: 20G).
                      The file is sparse, so this is a ceiling rather than a cost.
  VM_USER             console account passed as a systemd credential (default: buildc)
  VM_PASSWORD_HASH    its crypt(5) hash; when unset, run and spawn ask for a password
  GPU                 Y for hardware rendering in the qemu viewer (default: N)
EOF
}

command="${1:-}"
case "$command" in
    build | run | spawn) shift ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage
        die "unknown command '${command}'"
        ;;
esac

type="${1:-}"
shift || true
case "${command}/${type}" in
    */qcow2 | */raw) ;;
    */iso) die "an installer iso is \`buildc media build\`, not a vm disk" ;;
    *) die "'${command}' needs an image type (qcow2 or raw)" ;;
esac

image=""
tag="${DEFAULT_TAG:-latest}"
target=""
rebuild=0
ram=8G
installer=bib
login=0
ssh_key=""

while [ $# -gt 0 ]; do
    case "$1" in
        --image | --tag | --target | --ram | --installer | --ssh-key)
            [ "$#" -ge 2 ] || die "$1 needs a value"
            case "$1" in
                --image) image="$2" ;;
                --tag) tag="$2" ;;
                --target) target="$2" ;;
                --ram) ram="$2" ;;
                --ssh-key) ssh_key="$2" ;;
                --installer)
                    case "$2" in
                        bib | bootc) installer="$2" ;;
                        *) die "--installer is bib or bootc, not '$2'" ;;
                    esac
                    ;;
            esac
            shift 2
            ;;
        --rebuild)
            rebuild=1
            shift
            ;;
        --login)
            login=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage
            die "unknown argument '$1'"
            ;;
    esac
done

if [ -n "$image" ]; then
    ref="${image}:${tag}"
else
    ref="$(IMAGE_REGISTRY=localhost ./generated/scripts/buildc.sh registry ref --tag "$tag")"
fi

image_file="out/${type}/disk.${type}"

build_disk() {
    local config=disk_config/disk.toml tmp
    load_rootful
    mkdir -p out
    tmp="$(mktemp -p "${PWD}/out" -d bib.XXXXXXXX)"
    sudoif podman run \
        --rm -it --privileged --pull=newer --net=host \
        --security-opt label=type:unconfined_t \
        -v "$(realpath "$config")":/config.toml:ro \
        -v "$tmp":/output \
        -v /var/lib/containers/storage:/var/lib/containers/storage \
        "${BIB_IMAGE:-quay.io/centos-bootc/bootc-image-builder:latest}" \
        --type "$type" --use-librepo=True --rootfs=btrfs "$ref"
    sudoif mv -f "$tmp"/* out/
    sudoif rmdir "$tmp"
    sudoif chown -R "$(id -u):$(id -g)" out/
}

render_menu() {
    local raw="$1" lo target device root=""
    target="$(mktemp -d)"
    mkdir -p "${target}/boot"
    lo="$(sudoif losetup --show -fP "$raw")"
    for device in "${lo}"p*; do
        [ -b "$device" ] || continue
        sudoif mount "$device" "${target}/boot" 2> /dev/null || continue
        if [ -d "${target}/boot/loader/entries" ]; then
            root=/target
            break
        fi
        if [ -d "${target}/boot/boot/loader/entries" ]; then
            root=/target/boot
            break
        fi
        sudoif umount "${target}/boot"
    done
    if [ -z "$root" ]; then
        sudoif losetup -d "$lo"
        rmdir "${target}/boot" "$target" 2> /dev/null || true
        die "no partition of the disk carries \`loader/entries\`, so there is no menu to render"
    fi
    local status=0
    sudoif podman run --rm --net=none --security-opt label=disable \
        -v "${target}:/target" --entrypoint "" "$ref" \
        /bin/sh -c "test -x ${RENDERER} || exit 3; exec ${RENDERER} ${root}" || status=$?
    sudoif umount "${target}/boot"
    sudoif losetup -d "$lo"
    rmdir "${target}/boot" "$target" 2> /dev/null || true
    case "$status" in
        0) echo "vm: wrote the boot menu, since this image's GRUB reads no BLS" ;;
        3) ;;
        *) die "${RENDERER} in ${ref} failed: exit ${status}" ;;
    esac
}

install_disk() {
    command -v skopeo > /dev/null 2>&1 \
        || die "skopeo is not installed, and it writes the layout bootc installs from"
    command -v jq > /dev/null 2>&1 || die "jq is not installed, and it reads the install recipe"
    if [ "$type" = qcow2 ]; then
        command -v qemu-img > /dev/null 2>&1 \
            || die "qemu-img is not installed, and a qcow2 is converted from the raw disk"
    fi

    local raw="out/${type}/disk.raw.part" layout="out/oci-cache" key_args=() recipe bootloader
    recipe="$(./generated/scripts/buildc.sh recipe ${target:+--target "$target"})"
    bootloader="$(jq -r .bootloader <<< "$recipe")"
    local install_args=(--filesystem "$(jq -r .filesystem <<< "$recipe")")
    [ "$(jq -r .composeFsBackend <<< "$recipe")" != true ] || install_args+=(--composefs-backend)
    case "$bootloader" in
        "" | grub2) ;;
        *) install_args+=(--bootloader "$bootloader") ;;
    esac
    mkdir -p "out/${type}"
    rm -f "$raw"
    truncate -s "${DISK_SIZE:-20G}" "$raw"

    rm -rf "$layout"
    skopeo copy "containers-storage:${ref}" "oci:${layout}"

    # bootc ignores the root SSH key option on a composefs disk, so the key travels as a systemd credential.
    if [ -n "$ssh_key" ]; then
        [ -s "$ssh_key" ] || die "$ssh_key does not hold an SSH public key"
        key_args=(--karg "systemd.set_credential_binary=ssh.authorized_keys.root:$(base64 -w0 "$ssh_key")")
    fi

    load_rootful
    sudoif podman run \
        --rm --privileged --pull=never \
        --pid=host --net=host \
        -v /var/lib/containers:/var/lib/containers \
        -v /dev:/dev \
        -v "${PWD}/out/${type}":/out \
        -v "${PWD}/${layout}":/oci:ro \
        --security-opt label=type:unconfined_t \
        "$ref" \
        bootc install to-disk --via-loopback --source-imgref oci:/oci \
        --wipe --generic-image "${install_args[@]}" \
        "${key_args[@]}" /out/disk.raw.part

    sudoif chown -R "$(id -u):$(id -g)" out/
    render_menu "$raw"
    if [ "$type" = qcow2 ]; then
        qemu-img convert -O qcow2 "$raw" "${image_file}.part"
        rm -f "$raw"
        mv -f "${image_file}.part" "$image_file"
    else
        mv -f "$raw" "$image_file"
    fi
}

if [ "$command" = build ] || [ "$rebuild" = 1 ] || [ ! -f "$image_file" ]; then
    if [ "$rebuild" = 1 ]; then
        ./generated/scripts/buildc.sh generate
        args=(--backend buildah --tag "$ref")
        [ -z "$target" ] || args+=(--target "$target")
        ./generated/scripts/buildc.sh build "${args[@]}"
    fi
    case "$installer" in
        bib) build_disk ;;
        *) install_disk ;;
    esac
fi

if [ "$login" = 1 ] && [ "$command" != build ]; then
    login_credentials
fi

case "$command" in
    run) run_qemu ;;
    spawn)
        spawn_args=()
        if [ "$login" = 1 ]; then
            spawn_args=(
                --set-credential="sysusers.extra:${sysusers}"
                --set-credential="passwd.hashed-password.${vm_user}:${vm_password_hash}"
            )
        fi
        systemd-vmspawn \
            -M "bootc-image" \
            --console=gui \
            --cpus=2 \
            --ram="$(numfmt --from=iec "$ram")" \
            --network-user-mode \
            --vsock=false --pass-ssh-key=false \
            "${spawn_args[@]}" \
            -i "$image_file"
        ;;
esac
==== generated/scripts/media.sh
#!/usr/bin/env bash
# shellcheck disable=SC2034
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.."
[ -f repo.kdl ] || cd ..
source ./generated/lib/vm-helpers.sh

die() {
    echo "media: $*" >&2
    exit 1
}

usage() {
    cat >&2 << 'EOF'
usage: generated/scripts/media.sh <build|run> [options]

  build     assemble the installer ISO under out/bootiso/
  run       boot that ISO under qemu, building it if it is missing

  --image <ref>       container image the media installs (default: localhost/
                      and the plan's ungated published name)
  --tag <tag>         its tag (default: $DEFAULT_TAG, else latest)
  --target <image/flavour>
                      the target the media installs (default: the plan's
                      ungated target)
  --rebuild           generate, then build the container image first. The one
                      form of this that changes the repository.
  --ram <size>        memory for the virtual machine (default: 8G)
  --live-image <ref>  what the media boots, built here from out/bootiso/
                      Containerfile. `buildc media` names it, because this
                      script has no JSON reader to find it with.

Environment:
  VM_USER             console account passed as a systemd credential (default: buildc)
  VM_PASSWORD_HASH    its crypt(5) hash; when unset, run asks for a password
  GPU                 Y for hardware rendering in the qemu viewer (default: N)
EOF
}

command="${1:-}"
case "$command" in
    build | run) shift ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage
        die "unknown command '${command}'"
        ;;
esac

image=""
tag="${DEFAULT_TAG:-latest}"
target=""
rebuild=0
ram=8G
live_image=""
login=0

while [ $# -gt 0 ]; do
    case "$1" in
        --image | --tag | --target | --ram | --live-image)
            [ "$#" -ge 2 ] || die "$1 needs a value"
            case "$1" in
                --image) image="$2" ;;
                --tag) tag="$2" ;;
                --target) target="$2" ;;
                --ram) ram="$2" ;;
                --live-image) live_image="$2" ;;
            esac
            shift 2
            ;;
        --rebuild)
            rebuild=1
            shift
            ;;
        --login)
            login=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage
            die "unknown argument '$1'"
            ;;
    esac
done

if [ -n "$image" ]; then
    ref="${image}:${tag}"
else
    ref="$(IMAGE_REGISTRY=localhost ./generated/scripts/buildc.sh registry ref --tag "$tag")"
fi

type=iso
staged=out/bootiso
image_file="${staged}/install.iso"

build_media() {
    [ -n "$live_image" ] || die "--live-image names what the media boots; \`buildc media\` passes it"
    [ -f "${staged}/Containerfile" ] \
        || die "${staged}/Containerfile is not there; \`buildc media build\` stages it"
    [ -f "${staged}/media.json" ] \
        || die "${staged}/media.json is not there; \`buildc media build\` stages it"

    load_rootful
    rm -f "${image_file}.part"

    sudoif env HOME=/root LIVE="$live_image" PAYLOAD="$ref" \
        STAGED="${PWD}/${staged}" BUILD="${PWD}/${staged}/build" \
        ISO="${PWD}/${image_file}.part" OWNER="$(id -u):$(id -g)" \
        MODULE="${PWD}/generated/lib/media/90buildc-live" \
        bash -s << 'ROOT' || die "the media could not be assembled; the staging is under ${PWD}/${staged}/build"
set -euo pipefail

die() {
    echo "media: $*" >&2
    exit 1
}

for tool in jq podman skopeo mksquashfs mkfs.fat mcopy xorriso; do
    command -v "$tool" > /dev/null 2>&1 \
        || die "$tool is not installed, and it assembles the media"
done

mount_point=""
cleanup() {
    if mountpoint -q "${BUILD}/store/overlay" 2> /dev/null; then
        umount "${BUILD}/store/overlay" 2> /dev/null || true
    fi
    if [ -n "$mount_point" ]; then
        podman image unmount "$LIVE" > /dev/null 2>&1 || true
    fi
    chown -R "$OWNER" "$STAGED"
}
trap cleanup EXIT

manifest="$(podman image inspect --format '{{.ManifestType}}' "$PAYLOAD")" \
    || die "cannot read the manifest type of ${PAYLOAD} from root's store"
if [ "$manifest" != "application/vnd.oci.image.manifest.v1+json" ]; then
    skopeo copy --quiet --format oci \
        "containers-storage:${PAYLOAD}" "containers-storage:${PAYLOAD}" \
        || die "cannot store ${PAYLOAD} as OCI"
fi

image_id="$(podman image inspect --format '{{.Id}}' "$PAYLOAD")" \
    || die "cannot read the image ID of ${PAYLOAD}"
[[ "$image_id" =~ ^[0-9a-f]{64}$ ]] || die "podman named no image ID for ${PAYLOAD}"
printf '%s\n' "$image_id" > "${STAGED}/image-id"

media_name="$(jq -r '.media_name' "${STAGED}/media.json")"
env_id="$(jq -r '.bootable_environments[0].id' "${STAGED}/media.json")"
title="$(jq -r '.bootable_environments[0].title // .bootable_environments[0].id' "${STAGED}/media.json")"
payload_source="$(jq -r '.offline_payloads[0].source' "${STAGED}/media.json")"
payload_ref="$(jq -r '.offline_payloads[0].ref' "${STAGED}/media.json")"
[ -n "$media_name" ] && [ -n "$env_id" ] || die "media.json names no media or environment"

echo ">>> building the live environment ${LIVE}"
podman build -t "$LIVE" "$STAGED"

if mountpoint -q "${BUILD}/store/overlay" 2> /dev/null; then
    umount "${BUILD}/store/overlay" 2> /dev/null || true
fi
rm -rf "$BUILD"
iso_root="${BUILD}/iso/iso-root"
esp="${BUILD}/iso/esp-staging"
mkdir -p "$iso_root/LiveOS" "$iso_root/EFI/BOOT" "$iso_root/images/pxeboot" \
    "$esp/EFI/BOOT" "$esp/loader/entries" "$esp/images/pxeboot/${env_id}"

mount_point="$(podman image mount "$LIVE")" \
    || die "cannot mount ${LIVE}"

echo ">>> squashing the live root"
mksquashfs "$mount_point" "${iso_root}/LiveOS/${env_id}.rootfs.sfs" \
    -noappend -comp zstd -Xcompression-level 3 -b 131072 -processors 4 \
    -e proc -e sys -e dev -e run -e tmp -e var/lib/containers/storage \
    > /dev/null

kver=""
for dir in "$mount_point"/usr/lib/modules/*; do
    [ -f "${dir}/vmlinuz" ] || continue
    case "${dir##*/}" in
        *debug*) continue ;;
    esac
    kver="${dir##*/}"
    break
done
[ -n "$kver" ] || die "${LIVE} carries no non-debug kernel"

echo ">>> rebuilding the initramfs for ${kver}"
podman run --rm --privileged \
    -v "${MODULE}:/usr/lib/dracut/modules.d/90buildc-live:ro" \
    -v "${esp}/images/pxeboot/${env_id}:/out" \
    "$LIVE" \
    dracut --force --no-hostonly --add buildc-live --kver "$kver" /out/initrd.img \
    || die "cannot rebuild the initramfs; does ${LIVE} ship dracut?"
cp "${mount_point}/usr/lib/modules/${kver}/vmlinuz" \
    "${esp}/images/pxeboot/${env_id}/vmlinuz"

suffix=x64
[ "$(uname -m)" != aarch64 ] || suffix=aa64
shim="$(find "$mount_point/usr/lib/efi/shim" -path "*/EFI/*/shim${suffix}.efi" -type f 2> /dev/null | sort | head -n1)"
grub="$(find "$mount_point/usr/lib/efi/grub2" -path "*/EFI/*/grub${suffix}.efi" -type f 2> /dev/null | sort | head -n1)"
vendor=""
if [ -n "$shim" ] && [ -n "$grub" ]; then
    vendor="$(basename "$(dirname "$shim")")"
else
    shim="$mount_point/usr/lib/shim/shim${suffix}.efi.signed"
    [ -f "$shim" ] || shim=""
    grub="$(find "$mount_point/usr/lib/grub" -name "grub${suffix}.efi.signed" -type f 2> /dev/null | sort | head -n1)"
    vendor="$(sed -n 's/^ID=//p' "$mount_point/etc/os-release" 2> /dev/null | tr -d '"' | head -n1)"
fi
[ -n "$shim" ] && [ -n "$grub" ] \
    || die "${LIVE} ships no signed shim and GRUB pair"
cp "$shim" "${esp}/EFI/BOOT/BOOT${suffix^^}.EFI"
cp "$grub" "${esp}/EFI/BOOT/grub${suffix}.efi"
mm="$(dirname "$shim")/mm${suffix}.efi"
[ -f "$mm" ] || mm="$(dirname "$shim")/mm${suffix}.efi.signed"
[ ! -f "$mm" ] || cp "$mm" "${esp}/EFI/BOOT/mm${suffix}.efi"

options="root=buildc:CDLABEL=${media_name// /\\x20} buildc.live.squashimg=${env_id}.rootfs.sfs buildc.live.overlay.size=8192 enforcing=0 console=ttyS0,115200n8"
menu() {
    echo "set default=0"
    echo "set timeout=3"
    echo
    echo "menuentry '${title} (live)' {"
    echo "    linux /images/pxeboot/${env_id}/vmlinuz ${options}"
    echo "    initrd /images/pxeboot/${env_id}/initrd.img"
    echo "}"
}
menu > "${esp}/EFI/BOOT/grub.cfg"
if [ -n "$vendor" ]; then
    mkdir -p "${esp}/EFI/${vendor}"
    menu > "${esp}/EFI/${vendor}/grub.cfg"
fi

{
    echo "title ${title} (live)"
    echo "sort-key 0-buildc-${env_id}"
    echo "linux /images/pxeboot/${env_id}/vmlinuz"
    echo "initrd /images/pxeboot/${env_id}/initrd.img"
    echo "options ${options}"
} > "${esp}/loader/entries/${env_id}.conf"
printf 'timeout 5\ndefault *\nconsole-mode max\neditor no\n' > "${esp}/loader/loader.conf"

cp -a "${esp}/EFI/." "${iso_root}/EFI/"
cp -a "${esp}/images/pxeboot/." "${iso_root}/images/pxeboot/"

kb="$(du -sk "$esp" | cut -f1)"
mb=$(((kb * 12 / 10) / 1024 + 32))
truncate -s "${mb}M" "${iso_root}/EFI/efi.img"
mkfs.fat -F 32 -n ESP "${iso_root}/EFI/efi.img" > /dev/null
MTOOLS_SKIP_CHECK=1
for entry in "$esp"/*; do
    mcopy -i "${iso_root}/EFI/efi.img" -s "$entry" ::/
done

echo ">>> packing the offline store"
store="${BUILD}/store"
store_run="${BUILD}/store-run"
if mountpoint -q "${store}/overlay" 2> /dev/null; then
    umount "${store}/overlay" 2> /dev/null || true
fi
rm -rf "$store" "$store_run"
mkdir -p "${store}/etc/containers" "$store_run"
printf '[storage]\ndriver = "overlay"\n' > "${store}/etc/containers/storage.conf"
skopeo copy --remove-signatures \
    "containers-storage:${payload_source}" \
    "containers-storage:[overlay@${store}+${store_run}]${payload_ref}" \
    || die "cannot copy ${payload_source} into the offline store"
mksquashfs "$store" "${iso_root}/LiveOS/store.squashfs.img" \
    -noappend -comp zstd -Xcompression-level 3 -b 131072 -processors 4 \
    > /dev/null

echo ">>> assembling the ISO"
touch "$ISO"
xorriso -dev "stdio:${ISO}" -volid "$media_name" \
    -rockridge on -joliet on -map "$iso_root" / \
    -boot_image any platform_id=0xef \
    -boot_image any efi_path=EFI/efi.img \
    -boot_image any part_like_isohybrid=on -commit \
    || die "xorriso cannot assemble ${ISO}"
ROOT

    mv -f "${image_file}.part" "$image_file"
}

if [ "$command" = build ] || [ "$rebuild" = 1 ] || [ ! -f "$image_file" ]; then
    if [ "$rebuild" = 1 ]; then
        ./generated/scripts/buildc.sh generate
        args=(--backend buildah --tag "$ref")
        [ -z "$target" ] || args+=(--target "$target")
        ./generated/scripts/buildc.sh build "${args[@]}"
    fi
    build_media
fi

if [ "$login" = 1 ]; then
    login_credentials
fi

case "$command" in
    run) run_qemu ;;
esac
