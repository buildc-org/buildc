---
source: tests/golden/harness.rs
---
### Base Image
FROM ${BASE} AS rootfs

## Component layers

# ---- /opt build root ----
RUN mv /opt /opt.bak && mkdir /opt

# ---- /usr/local build root ----
RUN if [ -L /usr/local ]; then mv /usr/local /usr/local.bak && \
    mkdir -p /usr/local/bin /usr/local/etc /usr/local/games /usr/local/include \
    /usr/local/lib /usr/local/lib64 /usr/local/libexec /usr/local/share /usr/local/src; fi

# ---- core/first ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/broken-overlay/components/core/first.sh,target=/generated/broken-overlay/components/core/first.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/broken-overlay/components/core/first.sh

# ---- core/first overlays ----
COPY --from=ctx /generated/broken-overlay/components/core/first/files/ /

# ---- core/second ----
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/broken-overlay/components/core/second.sh,target=/generated/broken-overlay/components/core/second.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/broken-overlay/components/core/second.sh

# ---- core/second overlays ----
COPY --from=ctx /generated/broken-overlay/components/core/second/files/ /

# ---- core/second after the copies ----
RUN --network=none --mount=type=bind,from=ctx,source=/generated/broken-overlay/components/core/second.sh.tail.sh,target=/generated/broken-overlay/components/core/second.sh.tail.sh \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/broken-overlay/components/core/second.sh.tail.sh

# ---- core/third ----
RUN --mount=type=bind,from=ctx,source=/generated/broken-overlay/components/core/third,target=/ctx/components/core/third \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/generated/broken-overlay/components/core/third.sh,target=/generated/broken-overlay/components/core/third.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /generated/broken-overlay/components/core/third.sh

# ---- image version ----
ARG IMAGE_VERSION=dev

# ---- base family ----
ARG FAMILY=fedora

# ---- image identity ----
ARG IMAGE_ID="broken-overlay"
ARG IMAGE_REGISTRY=""

# ---- finalize ----
RUN --mount=type=bind,from=ctx,source=/generated/broken-overlay/finalize.sh,target=/generated/broken-overlay/finalize.sh \
    --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    IMAGE_VERSION="${IMAGE_VERSION}" FAMILY="${FAMILY}" IMAGE_ID="${IMAGE_ID}" IMAGE_REGISTRY="${IMAGE_REGISTRY}" bash /generated/broken-overlay/finalize.sh


COPY --from=ctx /generated/plan.json /usr/share/buildc/manifest.json

ARG BASE
ARG BASE_DECLARED=""
ARG TARGET=""
ARG SOURCE_COMMIT=""
ARG BUILD_BACKEND=""
ARG COMPONENT_HASHES=""
ARG ASSET_RESOLUTIONS=""
ARG BUILDC_VERSION=""
RUN --mount=type=bind,from=ctx,source=/generated/lib,target=/ctx/lib \
    BASE="${BASE}" BASE_DECLARED="${BASE_DECLARED}" TARGET="${TARGET}" \
    SOURCE_COMMIT="${SOURCE_COMMIT}" BUILD_BACKEND="${BUILD_BACKEND}" \
    COMPONENT_HASHES="${COMPONENT_HASHES}" \
    ASSET_RESOLUTIONS="${ASSET_RESOLUTIONS}" BUILDC_VERSION="${BUILDC_VERSION}" \
    IMAGE_ID="${IMAGE_ID}" IMAGE_VERSION="${IMAGE_VERSION}" bash /ctx/lib/build-record.sh

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
