schema-version 1
name "Deb Families"

builds default="debian" {
    debian {
        install {
            filesystem "btrfs"
            bootloader "systemd"
        }
    }
    forky {
        install {
            bootloader "grub2"
        }
    }
    ubuntu {
        install {
            bootloader "grub2"
        }
    }
}

