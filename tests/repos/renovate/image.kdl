schema-version 1

image "renovate" {
    base-image {
        fedora-bootc-44
    }

    layout {
        bootloader "grub2"
    }

    flavours {
        beta
    }

    fedora-family
    apps {
        browser {
            lang-version "2"
            version "128.0"
        }
    }
    apps {
        editor
    }
    apps {
        image-viewer@1 { version "3.1"; }
    }
    flavour "beta" {
        apps {
            browser {
                version "129.0"
            }
        }
    }
}
